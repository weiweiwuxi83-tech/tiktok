{
  "db_path": "data/monitor.db",
  "listen_host": "0.0.0.0",
  "listen_port": 8000,
  "interval_minutes": 60,
  "top_n": 10,
  "source": "mock",
  "sources": {
    "echotik": {
      "base_url": "https://open-api.echotik.com",
      "token_env": "ECHOTIK_TOKEN",
      "timeout_seconds": 30,
      "endpoints": {
        "videos": "/v1/hot/videos?region={country}",
        "creators": "/v1/hot/creators?region={country}",
        "songs": "/v1/hot/songs?region={country}",
        "tags": "/v1/hot/tags?region={country}",
        "lives": "/v1/hot/lives?region={country}"
      },
      "mapping": {
        "list": "data.list",
        "rank": "rank",
        "key": "id",
        "name": "title",
        "value": "play_count"
      }
    },
    "fastmoss": {
      "base_url": "https://api.fastmoss.com",
      "token_env": "FASTMOSS_TOKEN",
      "timeout_seconds": 30,
      "endpoints": {
        "videos": "/api/tiktok/hot-videos?country={country}",
        "creators": "/api/tiktok/hot-creators?country={country}",
        "songs": "/api/tiktok/hot-songs?country={country}",
        "tags": "/api/tiktok/hot-tags?country={country}",
        "lives": "/api/tiktok/hot-lives?country={country}"
      },
      "mapping": {
        "list": "data",
        "rank": "rank",
        "key": "unique_id",
        "name": "nickname",
        "value": "play_count"
      }
    }
  },
  "countries": {
    "ID": "印度尼西亚",
    "TH": "泰国",
    "VN": "越南",
    "PH": "菲律宾",
    "MY": "马来西亚",
    "SG": "新加坡"
  },
  "chart_types": {
    "videos": "热门视频",
    "creators": "创作者",
    "songs": "热门音乐",
    "tags": "话题标签",
    "lives": "带货直播"
  },
  "alerts": {
    "new_in_top10": true,
    "surge_min_rank_gain": 5,
    "dropout_periods": 3
  },
  "webhook_url": ""
}